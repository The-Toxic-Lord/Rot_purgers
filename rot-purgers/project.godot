;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rot_purgers"
run/main_scene="uid://bogj2hsowywaw"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GlobalData="*uid://cosxiqa26w5hj"
BattleHandler="*uid://c7pofalu7knhn"
SoundHandler="*uid://b2tvljyop82p8"
DialogueManager="*uid://c3rodes2l3gxb"
DialogueBalloon="*uid://c3bivus2b5x53"
ObjectLink="*uid://vwt0sbqumcjc"

[dialogue_manager]

runtime/balloon_path="res://dialogue/Dialogue_balloon.tscn"
editor/wrap_long_lines=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/GPUTrail-main/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

