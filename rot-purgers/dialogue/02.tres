[sub_resource type="Resource" id="Resource_auvwf"]
script = ExtResource("1_ghnu5")
char_name = "Alastor"
text = "Ambient magic seems more powerful here. "

[sub_resource type="Resource" id="Resource_i3cih"]
script = ExtResource("1_ghnu5")
char_name = "Elliot"
text = "Too powerful."

[sub_resource type="Resource" id="Resource_1flnf"]
script = ExtResource("1_ghnu5")
char_name = "Alastor"
text = "I fail to see the harm."

[sub_resource type="Resource" id="Resource_f0e7p"]
script = ExtResource("1_ghnu5")
char_name = "Elliot"
text = "The deeper we descend, the more uncontrollable spells become. At best they collapse. At worst, they amplify. I was with a team here long before. We had to retreat after one fool smashed his head on the ceiling, trying to fly."

[sub_resource type="Resource" id="Resource_kxx33"]
script = ExtResource("1_ghnu5")
char_name = "Alastor"
text = "I begin to see how this place can be the source of the Rot."

[sub_resource type="Resource" id="Resource_x2cqe"]
script = ExtResource("1_ghnu5")
char_name = "Elliot"
text = "We will find our answer deeper."

