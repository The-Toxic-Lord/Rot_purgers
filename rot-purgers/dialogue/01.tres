[sub_resource type="Resource" id="Resource_4r1gm"]
script = ExtResource("1_4r1gm")
char_name = "Alastor"
text = "Oh! Good afternoon, High Chancellor. Were you perhaps waiting for me?"

[sub_resource type="Resource" id="Resource_p11pi"]
script = ExtResource("1_4r1gm")
char_name = "Elliot"
text = "Quite so. It would seem that our investigations have led us to the same place."

[sub_resource type="Resource" id="Resource_mqldu"]
script = ExtResource("1_4r1gm")
char_name = "Alastor"
text = "Have you already been down there?"

[sub_resource type="Resource" id="Resource_04cnf"]
script = ExtResource("1_4r1gm")
char_name = "Elliot"
text = "No. I sensed your presence approaching and decided to wait."

[sub_resource type="Resource" id="Resource_e0qr1"]
script = ExtResource("1_4r1gm")
char_name = "Alastor"
text = "Thank you! It is always a pleasure to see a master at work!"

[sub_resource type="Resource" id="Resource_7g4dm"]
script = ExtResource("1_4r1gm")
char_name = "Elliot"
text = "Hmm. As time goes by, your attitude still doesn't change. Follow me."

